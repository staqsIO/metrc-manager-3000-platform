# Copy to .env and fill in. Keep every comment on its own line:
# `docker run --env-file` treats trailing text on a value line as part of the value.

# ---- Required ----
DATABASE_URL=postgresql://metrc:change-me@localhost:5432/metrc
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Generate with: openssl rand -hex 32  (never change after first use)
METRC_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 16  (never change after first use)
METRC_ENCRYPTION_SALT=
APP_URL=http://localhost:3000

# ---- Server / runtime ----
# Port the web process listens on in Docker
PORT=3000
# Canonical base URL used by NextAuth and links (the Docker entrypoint defaults it to APP_URL)
NEXTAUTH_URL=
# Fallback base URL for server code when NEXTAUTH_URL is unset
NEXT_PUBLIC_APP_URL=
# Set to false to disable the METRC platform features (kill switch)
METRC_PLATFORM_ENABLED=true
# Set to 1 or true to enable Copilot agent runs
AGENT_RUNS_ENABLED=

# ---- Database ----
# Defaults to DATABASE_URL. Migrations only run against DATABASE_URL: pointing this at a separate
# database is unsupported unless you also apply the migrations to it yourself.
DASHBOARD_DATABASE_URL=
# Same as DATABASE_URL unless you use a pooler; Docker sets it automatically
DIRECT_URL=postgresql://metrc:change-me@localhost:5432/metrc
# In-memory cache is used when unset
REDIS_URL=

# ---- Auth ----
# Google sign-in is enabled only when both ID and secret are set (requires a verified Google email)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list; empty means no restriction
ALLOWED_EMAIL_DOMAINS=
# Public sign-up is off unless true; create the first admin with `pnpm create-admin`
OPEN_SIGNUP=false
# Comma-separated token issuers allowed for portal auto-login (read at runtime, server side);
# empty disables portal auto-login
AUTO_LOGIN_ISSUER_WHITELIST=

# ---- create-admin script defaults (flags --email/--password/--org take precedence) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ORG=

# ---- METRC integrator (vendor) keys; facilities can also store their own ----
METRC_VENDOR_API_KEY=
METRC_VENDOR_API_KEY_CO=
METRC_USER_API_KEY=
METRC_USER_API_KEY_CO=

# ---- Integrations ----
RESEND_API_KEY=
MULTIAGENT_API_URL=
MULTIAGENT_API_KEY=
METRC_MCP_URL=
METRC_MCP_API_KEY=
METRC_DOCS_MCP_URL=
METRC_DOCS_MCP_API_KEY=
# Shared secret for authenticating cron-triggered endpoints
CRON_SECRET=

# ---- Docker cron schedules (cron mode); empty disables the job ----
# Daily sync
CRON_SYNC_DAILY=0 7 * * *
# Monthly full sync
CRON_SYNC_FULL=0 8 1 * *
# Hourly active-sales sync
CRON_SYNC_SALES=0 * * * *

# ---- Branding ----
# Brand name and logo are BUILD-TIME only: NEXT_PUBLIC_BRAND_NAME / NEXT_PUBLIC_BRAND_LOGO_URL are
# inlined at `next build` (Docker build args of the same name). Changing them at runtime has no
# effect; rebuild the image. Defaults: Formul8 and /brand/logo.svg. The root docker compose maps
# its BRAND_NAME / BRAND_LOGO_URL settings to these build args.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_LOGO_URL=
SUPPORT_EMAIL=
EMAIL_FROM=
# Optional; defaults to ${APP_URL}/brand/logo.png
EMAIL_LOGO_URL=

# ---- LLM bootstrap (once per install) ----
# Used only by `migrate`, once per install, when no LLM provider exists yet. Afterwards manage
# providers in Super Admin > LLM Providers (/admin/llm-providers); deleting all providers
# disables AI and is not re-seeded from these variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Key service is only used with OpenRouter; both URL and token are needed to create a provider from it alone
KEY_SERVICE_URL=
KEY_SERVICE_API_KEY=
# http://ollama:11434 (compose profile) or http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:14b
# openrouter or ollama; defaults to openrouter when both are configured
LLM_DEFAULT_PROVIDER=

# ---- Copilot eval harness only (pnpm copilot:eval) ----
# USER_ID=
# FACILITY_ID=
# ORG_MODE=
