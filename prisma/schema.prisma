/// Catalog: Strain master list snapshot (Phase 3).
/// Populated by catalog-sync.ts, daily cadence.
model StrainSnapshot {
  id                String    @id @default(cuid())
  facilityId        String
  metrcStrainId     Int
  name              String
  testingStatus     String?
  thcLevel          Decimal?  @db.Decimal(6, 3)
  cbdLevel          Decimal?  @db.Decimal(6, 3)
  indicaPercentage  Decimal?  @db.Decimal(6, 2)
  sativaPercentage  Decimal?  @db.Decimal(6, 2)
  isActive          Boolean   @default(true)
  rawPayload        Json?
  lastSyncedAt      DateTime  @default(now())
  capturedAt        DateTime  @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, metrcStrainId])
  @@index([facilityId, isActive])
  @@index([facilityId, name])
  @@map("strain_snapshots")
}

// ============================================================
// HISTORICAL TRANSFER LINE ITEMS (Example Farms CSV Import)
// ============================================================

model TransferLineItem {
  id                  String   @id @default(cuid())
  facilityId          String
  manifestNumber      String
  originLicenseNumber String
  originFacilityName  String
  originFacilityType  String?
  destLicenseNumber   String
  destFacilityName    String
  destFacilityType    String?
  transferType        String   // 'affiliated' | 'wholesale'
  createdDateTime     String?
  receivedDateTime    String?
  isVoided            Boolean  @default(false)
  // Package details
