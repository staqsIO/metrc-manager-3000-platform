  receivedWeightUoM   String?
  // Variance
  countVariancePct    Float?
  weightVariancePct   Float?
  // Wholesale pricing (from wholesale CSV or API)
  shipperWholesalePrice  Float?
  receiverWholesalePrice Float?
  // Import metadata
  importSource        String   // 'csv_affiliated' | 'csv_wholesale' | 'api'
  importedAt          DateTime @default(now())
  importBatchId       String

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, manifestNumber, itemName, packageLabel])
  @@index([facilityId, transferType])
  @@index([facilityId, itemCategory])
  @@index([facilityId, createdDateTime])
  @@index([importBatchId])
  @@map("transfer_line_items")
}

/// Per-facility configurable thresholds, targets, and benchmarks.
/// Replaces hardcoded constants (e.g., getAgeCategory 30/60/90 day thresholds)
/// with operator-defined values. Used by operational intelligence engines,
/// compliance checks, and Copilot tools.
///
/// category scopes a benchmark to a specific domain (aging, yield, freshness, compliance).
/// key identifies the specific metric within that category.
/// value is the numeric threshold or target.
///
/// Examples:
///   { category: "aging", key: "fresh_days", value: 30 }
///   { category: "aging", key: "normal_days", value: 60 }
///   { category: "aging", key: "aging_days", value: 90 }
///   { category: "yield", key: "distillation_target_pct", value: 75 }
///   { category: "freshness", key: "wet_whole_plant_hours", value: 72 }
///   { category: "compliance", key: "plant_limit", value: 5000 }
///   { category: "cost", key: "flower_cost_per_lb", value: 300 }
model OperatorBenchmark {
  id         String   @id @default(cuid())
  facilityId String
  category   String   // "aging" | "yield" | "freshness" | "compliance" | "cost" | "alert"
  key        String   // Metric identifier within the category
  value      Float    // Numeric threshold, target, or benchmark
  unit       String?  // Optional unit label ("days", "%", "lbs", "$")
  label      String?  // Optional human-readable label for UI display
  notes      String?  // Operator notes on why this benchmark was set
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, category, key])
  @@index([facilityId, category])
  @@map("operator_benchmarks")
}

/// Per-package sales line items from Metrc receipts.
/// Initial load via CSV import, then incremental sync via nightly cron.
/// Active receipts are always live from Metrc API; inactive reads from here.
model RetailSale {
  id              String   @id @default(cuid())
  facilityId      String
  receiptId       Int      // Metrc receipt ID
  receiptNumber   String
  packageLabel    String
  productName     String
  productCategory String?
  customerType    String?  // Consumer, Patient, Caregiver
  quantity        Decimal  @db.Decimal(12, 4)
  unitPrice       Decimal? @db.Decimal(12, 4)
  totalPrice      Decimal  @db.Decimal(12, 4)
  unitOfMeasure   String?
  soldAt          DateTime
  capturedAt      DateTime @default(now())
  rawPayload      Json?
  finalized       Boolean  @default(false)
  sourcePackageLabel String?

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, receiptId, packageLabel])
  @@index([facilityId, soldAt(sort: Desc)])
  @@index([facilityId, finalized, soldAt(sort: Desc)])
  @@index([packageLabel, soldAt(sort: Desc)])
  @@index([facilityId, productCategory])
  @@map("retail_sales")
}

/// Receipt-level summary table for fast paginated list + summary cards.
/// One row per receipt (vs RetailSale which has one row per package/line item).
/// Eliminates expensive GROUP BY on 1.3M+ line items.
model RetailSaleReceipt {
  id            String   @id @default(cuid())
  facilityId    String
  receiptId     Int
  receiptNumber String
  customerType  String?
  lineItemCount Int
  totalPrice    Decimal  @db.Decimal(12, 4)
  soldAt        DateTime
  finalized     Boolean  @default(false)
  capturedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, receiptId])
  @@index([facilityId, soldAt(sort: Desc)])
  @@index([facilityId, customerType])
  @@map("retail_sale_receipts")
}

/// Package snapshot — synced daily from Metrc /packages/v2/active and /packages/v2/inactive.
/// Eliminates the 111-API-call cost per page load (2,210 packages / 20 per page).
/// Pages read from this table; cron refreshes nightly + on-demand via refresh button.
model PackageSnapshot {
  id                String    @id @default(cuid())
  facilityId        String
  metrcPackageId    Int       // Metrc package ID
  packageLabel      String
  packageType       String?
  itemId            Int?
  itemName          String
  itemCategory      String?
  quantity          Decimal   @db.Decimal(12, 4)
  unitOfMeasure     String?
  locationName      String?
  packagedDate      DateTime?
  productCategory   String?
  itemStrainName    String?
  isFinished        Boolean   @default(false)
  isActive          Boolean   @default(true) // false = no longer in Metrc API (sold/transferred)
  // Persisted so engines' `if (pkg.FinishedDate || pkg.ArchivedDate) continue`
  // guard actually fires. Metrc's "active" list still includes packages with
  // these set, so we filter them out at the read layer.
  finishedDate      DateTime?
  archivedDate      DateTime?
  // Phase 1 additions
  metrcLastModified DateTime? // Metrc's LastModified timestamp — enables per-row staleness checks
  labTestingState   String?   // Promoted from rawPayload: TestPassed, TestFailed, NotSubmitted, SubmittedForTesting
  isOnHold          Boolean   @default(false) // Promoted from rawPayload for compliance queries
  sourceHarvestNames String?  // Promoted from rawPayload for frequently joined harvest lookups
  rawPayload        Json?
  lastSyncedAt      DateTime  @default(now())
  capturedAt        DateTime  @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, metrcPackageId])
  @@index([facilityId, isActive, packagedDate])
  @@index([facilityId, productCategory])
  @@index([facilityId, itemName])
  @@index([facilityId, labTestingState])
  @@index([facilityId, isOnHold])
  @@index([facilityId, packageLabel])
  @@map("package_snapshots")
}

/// Per-facility per-endpoint sync watermarks for incremental API sync.
/// Crons use lastModifiedStart/lastModifiedEnd on Metrc v2 endpoints
/// to fetch only rows changed since the last successful run.
model SyncWatermark {
  id            String    @id @default(cuid())
  facilityId    String
  endpoint      String    // 'sales.receipts.inactive' | 'packages.inactive' | ...
  entityState   String?   // Per-status-variant watermarks: 'active' | 'inactive' | null
  watermark     String?   // ISO timestamp — max LastModified from last successful run
  lastRunAt     DateTime?
  lastRunStatus String?   // 'success' | 'partial' | 'failed' | 'skipped'
  lastError     String?
  lockedAt      DateTime?
  lockedBy      String?
  runCount      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, endpoint])
  @@index([facilityId, endpoint, lastRunAt])
  @@map("sync_watermarks")
}

/// Monthly API call budget enforcement.
/// Single row per month — atomically incremented before each Metrc call.
model ApiCallBudget {
  id            String   @id @default(cuid())
  yearMonth     String   @unique // '2026-04' format
  callsUsed     Int      @default(0)
  callsCap      Int      @default(125000)
  lastUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@map("api_call_budgets")
}

/// Plant snapshot — synced from Metrc /plants/v2/vegetative and /plants/v2/flowering.
/// Phase 2: replaces live getActivePlants() calls in plants.ts, analytics.ts routers.
model PlantSnapshot {
  id                String    @id @default(cuid())
  facilityId        String
  metrcPlantId      Int       // Metrc plant ID
  label             String
  state             String?   // Vegetative, Flowering, Harvested, Destroyed, etc.
  growthPhase       String?   // Vegetative, Flowering
  plantBatchName    String?
  plantBatchTypeName String?
  strainName        String?
  locationName      String?
  roomName          String?
  isOnHold          Boolean   @default(false)
  plantedDate       DateTime?
  vegetativeDate    DateTime?
  floweringDate     DateTime?
  harvestedDate     DateTime?
  destroyedDate     DateTime?
  metrcLastModified DateTime?
  isActive          Boolean   @default(true) // false = harvested/destroyed
  rawPayload        Json?
  lastSyncedAt      DateTime  @default(now())
  capturedAt        DateTime  @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, metrcPlantId])
  @@index([facilityId, isActive, growthPhase])
  @@index([facilityId, strainName])
  @@map("plant_snapshots")
}

/// Plant batch snapshot — synced from Metrc /plantbatches/v2/active and /plantbatches/v2/inactive.
/// Phase 2: replaces live getActivePlantBatches() calls in plant-batches.ts router.
model PlantBatchSnapshot {
  id                String    @id @default(cuid())
  facilityId        String
  metrcBatchId      Int       // Metrc plant batch ID
  name              String
  type              String?   // Seed, Clone
  strainName        String?
  locationName      String?
  roomName          String?
  count             Int       @default(0)
  untrackedCount    Int       @default(0)
  trackedCount      Int       @default(0)
  packagedCount     Int       @default(0)
  harvestedCount    Int       @default(0)
  destroyedCount    Int       @default(0)
  plantedDate       DateTime?
  metrcLastModified DateTime?
  isActive          Boolean   @default(true) // false = fully used/destroyed
  rawPayload        Json?
  lastSyncedAt      DateTime  @default(now())
  capturedAt        DateTime  @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, metrcBatchId])
  @@index([facilityId, isActive])
  @@index([facilityId, strainName])
  @@map("plant_batch_snapshots")
}

/// Harvest snapshot — synced from Metrc /harvests/v2/active, /harvests/v2/onhold, /harvests/v2/inactive.
/// Phase 2: replaces live getActiveHarvests()/getInactiveHarvests() calls in harvests.ts, waste.ts, analytics.ts.
model HarvestSnapshot {
  id                  String    @id @default(cuid())
  facilityId          String
  metrcHarvestId      Int       // Metrc harvest ID
  name                String
  harvestType         String?
  sourceStrainNames   String?
  dryingLocationName  String?
  currentWeight       Decimal   @db.Decimal(12, 4) @default(0)
  totalWasteWeight    Decimal   @db.Decimal(12, 4) @default(0)
  totalRestoredWeight Decimal   @db.Decimal(12, 4) @default(0)
  packageCount        Int       @default(0)
  totalPackagedWeight Decimal   @db.Decimal(12, 4) @default(0)
  unitOfWeightName    String?
  labTestingState     String?
  isOnHold            Boolean   @default(false)
  harvestStartDate    DateTime?
  finishedDate        DateTime?
  archivedDate        DateTime?
  metrcLastModified   DateTime?
  isActive            Boolean   @default(true) // false = finished/archived
  rawPayload          Json?
  lastSyncedAt        DateTime  @default(now())
  capturedAt          DateTime  @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, metrcHarvestId])
  @@index([facilityId, isActive])
  @@index([facilityId, sourceStrainNames])
  @@map("harvest_snapshots")
}

/// Per-call observability for Metrc API requests. Written by
/// `MetrcInstrumentedClient` (src/services/metrc/instrumented-client.ts) for every
/// real network call (cache hits and mock-mode calls do NOT write rows). Consumed
/// by `observability.getApiCallStats` for per-endpoint latency / error / quota stats.
///
/// `statusCode` is best-effort: 200 on success, the error's `statusCode` field
/// (Metrc SDK MetrcApiError exposes this) on thrown errors, otherwise null.
/// `remainingQuota` and `requestId` are reserved for future SDK-level header
/// capture — the current `@metrc-manager-3000/client` package does not surface response
/// headers on success, so they remain null today.
model MetrcApiCall {
  id              String   @id @default(cuid())
  facilityId      String
  endpoint        String   // IMetrcClient method name, e.g. "getActivePackages"
  statusCode      Int?
  durationMs      Int
  ts              DateTime @default(now())
  remainingQuota  Int?
  requestId       String?
  error           String?

  @@index([facilityId, ts(sort: Desc)])
  @@index([facilityId, endpoint, ts(sort: Desc)])
  @@map("metrc_api_calls")
}

/// Lab test snapshot — synced from Metrc /labtests/v2/results.
/// Phase 2: replaces live getLabTestResults() calls in lab-tests.ts, analytics.ts.
/// Linked to PackageSnapshot via packageLabel.
model LabTestSnapshot {
  id                String    @id @default(cuid())
  facilityId        String
  packageId         Int       // Metrc package ID this test belongs to
  packageLabel      String
  testPerformedDate DateTime?
  overallPassed     Boolean
  testTypeName      String?
  testResultLevel   Decimal?  @db.Decimal(12, 4)
  testResultUnit    String?
  labFacilityName   String?
  metrcLastModified DateTime?
  rawPayload        Json?
  lastSyncedAt      DateTime  @default(now())
  capturedAt        DateTime  @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, packageId, testTypeName])
  @@index([facilityId, packageLabel])
  @@index([facilityId, overallPassed])
  @@map("lab_test_snapshots")
}

// ============================================================
// AGENT-FIRST COPILOT (Phase 1 — backend primitives)
// See docs/internal/adrs/agent-first-copilot.md (TBD).
// Run + Artifact + Notification = the durable spine of the
// Copilot rebuild. Each tRPC turn or scheduled trigger creates
// a Run, which produces one or more Artifacts the user can pin,
// share, or subscribe to. Read-only by default; writes are
// gated per-org via CopilotOrgSettings.copilotWritesEnabled and
// flow through the existing ActionLog Preview/Confirm path.
// ============================================================

model Run {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  // Logical reference to MetrcFacility — null for org-mode runs (cross-facility analytics).
  facilityId     String?  @map("facility_id")
  userId         String   @map("user_id")
  // skillId is a logical reference to COPILOT_SKILLS[].id. Null for free-form prompts.
  skillId        String?  @map("skill_id")
  // 'pending' | 'running' | 'awaiting_user' | 'completed' | 'failed' | 'scheduled'
  status         String   @default("pending")
  // The user message that started the run (for display + replay)
  prompt         String   @db.Text
  model          String?
  // Schedule descriptor — null for one-shot runs. JSONB shape:
  //   { cron: '0 9 * * 1', triggerOn: 'change' | 'always' }
  scheduleSpec   Json?    @map("schedule_spec")
  // Tool-loop transcript: array of { iteration, role, content?, toolCalls?, toolResult? }.
  // Append-only within a run; LangGraph migration target if loops grow past ~100 iters.
  iterations     Json     @default("[]")
  currentArtifactId String? @map("current_artifact_id")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  // Optional diagnostic surface
  toolsUsed      String[] @map("tools_used")
  errorMessage   String?  @map("error_message")
  // Multi-turn thread this Run belongs to. Null for legacy single-turn Runs
  // created before Conversation persistence shipped.
  conversationId String?  @map("conversation_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  artifacts Artifact[]
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([userId, createdAt])
  @@index([facilityId, status])
  @@index([skillId, organizationId])
  @@index([conversationId, createdAt])
  @@map("runs")
}

model Artifact {
  id             String   @id @default(cuid())
  runId          String   @map("run_id")
  organizationId String   @map("organization_id")
  // Logical reference; null for org-scoped artifacts.
  facilityId     String?  @map("facility_id")
  // 'Report' | 'Table' | 'Plan' | 'Recommendation' | 'DraftedAction'
  type           String
  title          String?
  // Pointer to the most recent ArtifactVersion (denormalized for fast reads).
  // Null while the first version is still being produced.
  currentVersionId String? @map("current_version_id")
  // Set when the user explicitly saves/pins this artifact for later. Drives
  // the "Saved Reports" surface and the click-through link from the activity
  // pane. Null = transient (will live alongside the run but not surface in
  // the saved list).
  pinnedAt       DateTime? @map("pinned_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  run      Run               @relation(fields: [runId], references: [id], onDelete: Cascade)
  versions ArtifactVersion[]

  @@index([runId])
  @@index([organizationId, type, createdAt])
  @@index([facilityId, type])
  @@index([organizationId, pinnedAt])
  @@map("artifacts")
}

model ArtifactVersion {
  id           String   @id @default(cuid())
  artifactId   String   @map("artifact_id")
  // Append-only payload — markdown content, table data, draft action shape, etc.
  content      Json
  // Optional reference to the iteration step in Run.iterations that produced this version.
  producedByTurnIdx Int? @map("produced_by_turn_idx")
  createdAt    DateTime @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId, createdAt])
  @@map("artifact_versions")
}

model Notification {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  // Optional links into Run/Artifact for click-through.
  runId          String?  @map("run_id")
  artifactId     String?  @map("artifact_id")
  // 'agent_finding' | 'drafted_action' | 'run_completed' | 'run_failed' etc.
  type           String
  // 'info' | 'warning' | 'critical'
  severity       String   @default("info")
  title          String
  body           String?  @db.Text
  read           Boolean  @default(false)
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, read, createdAt])
  @@index([organizationId, createdAt])
  @@index([runId])
  @@map("notifications")
}

// Multi-turn chat thread. A Conversation owns many Runs and many
// ConversationMessages — Runs are agentic executions within a turn,
// Messages are the chronological transcript shown to the user.
// Replaces the localStorage `chat-storage` namespace for cross-device
// continuity. organizationId + userId are logical references.
model Conversation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  // Logical reference to MetrcFacility — null for org-wide threads.
  facilityId     String?  @map("facility_id")
  // First user prompt (truncated to ~120 chars) or LLM-generated summary.
  title          String
  // Append-bumped on every message write so the rail can sort by recency
  // without reading the messages relation.
  lastMessageAt  DateTime @default(now()) @map("last_message_at")
  // Soft-archived threads stay queryable but drop out of the "Recent" list.
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  messages ConversationMessage[]
  runs     Run[]

  @@index([organizationId, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([facilityId, lastMessageAt])
  @@map("conversations")
}

// One row per chat turn (user prompt or assistant reply). Assistant rows
// link back to the Run that produced them via runId — null for user rows.
model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  // 'user' | 'assistant' | 'system'
  role           String
  content        String   @db.Text
  // For assistant messages, the Run that produced this content. Lets the
  // UI deep-link to the run's artifact + audit transcript.
  runId          String?  @map("run_id")
  // Anonymizer audit captured at write time — null for user messages.
  audit          Json?
  // Lightweight tools list for badge rendering without joining Run.
  toolsUsed      String[] @map("tools_used")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([runId])
  @@map("conversation_messages")
}

// Per-org Copilot settings. Lives in this DB rather than the dashboard
// Organization table because Copilot capability is owned by this repo and
// dashboard owns billing/identity. organizationId is a logical reference.
model CopilotOrgSettings {
  id                    String   @id @default(cuid())
  organizationId        String   @unique @map("organization_id")
  // Trust gate — when true, Copilot may write `ActionLog` rows in PREVIEWING
  // status for human review/submit. False (default) means analysis-only mode.
  copilotWritesEnabled  Boolean  @default(false) @map("copilot_writes_enabled")
  // Soft monthly cap (USD). Scheduled runs pause at 80% utilization.
  monthlyBudgetUsd      Decimal? @db.Decimal(10, 2) @map("monthly_budget_usd")
  // Per-org acceptance criteria for trust ladder — denormalized for ops dashboards
  draftedActionsCount   Int      @default(0) @map("drafted_actions_count")
  submittedActionsCount Int      @default(0) @map("submitted_actions_count")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("copilot_org_settings")
}


// ============================================================
// LLM providers (managed by super admins)
// ============================================================

enum LlmProviderType {
  OPENROUTER
  OLLAMA
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Free Copilot questions used on the public demo (DEMO_MODE=1), per day. `bucket` is a
/// salted hash of the visitor's IP, or "global" for the demo-wide total; raw IPs are never stored.
model DemoAiUsage {
  bucket String
  day    String // UTC date, YYYY-MM-DD
  count  Int    @default(0)

  @@id([bucket, day])
  @@map("demo_ai_usage")
}

model LlmProvider {
  id                       String          @id @default(cuid())
  name                     String          @unique
  type                     LlmProviderType
  baseUrl                  String
  apiKeyEncrypted          String?
  keyServiceUrl            String?
  keyServiceTokenEncrypted String?
  models                   String[]
  defaultModel             String
  fallbackModel            String?
  enabled                  Boolean         @default(true)
  isDefault                Boolean         @default(false)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@map("llm_providers")
}
