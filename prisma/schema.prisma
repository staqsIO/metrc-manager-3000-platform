// METRC Manager 3000 — Prisma schema (single PostgreSQL database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Users, organizations, roles

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  isPlatformAdmin   Boolean   @default(false)
  // Bumped whenever the user's auth-relevant state changes (new membership,
  // role change, org promote/demote). The NextAuth jwt callback compares
  // token.lastEnrichedAt against this to force JWT re-enrichment without requiring
  // sign-out + sign-in. See ADR-016 (Phase 0, structural fix #3).
  jwtInvalidatedAt  DateTime?
  // JWTs whose sign-in time (token.authTime) is before this are rejected on the
  // next throttled freshness check. Set when an OAuth sign-in converts an
  // unverified password account (pre-hijack defence).
  sessionsRevokedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships          Membership[]
  createdOrganizations Organization[] @relation("OrganizationOwner")

  @@map("users")
}

model UserIdentityMap {
  id                String   @id
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  canonicalEmail    String   @map("canonical_email")
  metadata          Json     @default("{}")
  linkedAt          DateTime @default(now()) @map("linked_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  // userId is a logical reference to the dashboard DB's User table (no cross-DB FK).
  // Same pattern as organizationId on MetrcFacility (see ADR-008).

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([canonicalEmail])
  @@map("user_identity_map")
}

model Organization {
  id               String                   @id @default(cuid())
  name             String
  slug             String                   @unique
  description      String?
  logoUrl          String?                  @map("logo_url")
  website          String?
  // Tenant isolation: PRODUCTION orgs run Metrc API calls and crons normally.
  // DEMO and TEST orgs are non-production: Metrc API is forced to mock, crons skip them.
  // See ADR-020 Phase 3 (FOR-1480). Default is PRODUCTION for backward compat.
  environment      OrganizationEnvironment  @default(PRODUCTION)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  ownerId          String

  owner          User                  @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  domains        OrganizationDomain[]

  @@index([environment])
  @@map("organizations")
}

enum OrganizationEnvironment {
  PRODUCTION
  DEMO
  TEST

}

// Domain claims for an Organization. When a user signs in with an email whose domain
// matches a VERIFIED OrganizationDomain row, they are auto-attached to that org as a
// MEMBER (or whatever defaultRoleName specifies) instead of getting a personal FREE
// org. Replaces the hardcoded CUSTOMER_DOMAIN_CLAIMS map shipped as a Phase 0 stop-gap.
// See ADR-020 Phase 2 (FOR-1479).
//
// A partial unique index `WHERE status = 'VERIFIED'` is enforced via raw SQL
// migration — only one org may actively claim a given domain, but PENDING/REJECTED/
// REVOKED rows for the same domain coexist (history + concurrent claim attempts).
model OrganizationDomain {
  id                  String                    @id @default(cuid())
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain              String                    // lowercased, trimmed, IDN-punycoded, no leading dot
  status              DomainVerificationStatus  @default(PENDING)
  method              DomainVerificationMethod  @default(ADMIN_EMAIL)
  defaultRoleName     String                    @default("MEMBER")
  includeSubdomains   Boolean                   @default(false)
  challengeTokenHash  String?                   // sha256 hash, never plaintext
  challengeExpiresAt  DateTime?
  verifiedAt          DateTime?
  verifiedByUserId    String?
  revokedAt           DateTime?
  revokedByUserId     String?
  createdByUserId     String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  events              OrganizationDomainEvent[]

  @@index([organizationId])
  @@index([domain])
  @@map("organization_domains")
}

model OrganizationDomainEvent {
  id          String                    @id @default(cuid())
  domainId    String
  domain      OrganizationDomain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  fromStatus  DomainVerificationStatus?
  toStatus    DomainVerificationStatus
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime                  @default(now())

  @@index([domainId, createdAt])
  @@map("organization_domain_events")
}

// Mailbox providers that may NEVER claim a domain (gmail, yahoo, etc.). Seeded from
// the previous hardcoded GENERIC_EMAIL_DOMAINS set in src/lib/user-organization.ts.
model GenericEmailDomain {
  domain    String   @id
  source    String   // 'seed' | 'admin' | 'imported:disposable-email-list'
  addedAt   DateTime @default(now())

  @@map("generic_email_domains")
}

enum DomainVerificationStatus {
  PENDING
  VERIFYING
  VERIFIED
  REVOKED
  REJECTED

}

enum DomainVerificationMethod {
  ADMIN_EMAIL  // v1: claimer must receive mail at @domain.com
  DNS_TXT      // v2 (deferred)
  MANUAL       // staff override (audit-logged via OrganizationDomainEvent)

}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef      Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  hierarchy   Int
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     Membership[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// SHARED ENUMS (from dashboard)
// ============================================================

// ============================================================
// NEW METRC-SPECIFIC MODELS
// ============================================================

model MetrcFacility {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  licenseNumber    String
  stateCode        String   @db.VarChar(2)
  facilityType     String?  // Cultivator, Manufacturer, Dispensary, etc.
  // Encrypted Metrc API credentials (production)
  encryptedVendorApiKey String?
  encryptedUserApiKey   String?
  // Encrypted Metrc API credentials (sandbox)
  encryptedSandboxVendorApiKey String?
  encryptedSandboxUserApiKey   String?
  // Connection state: "mock" | "sandbox" | "production"
  metrcEnvironment String   @default("mock")
  // Detected Metrc key access level: "full" | "readonly" (null = unknown/not tested)
  metrcKeyAccess              String?  // production key access level
  sandboxMetrcKeyAccess       String?  // sandbox key access level
  // Per-user credential enforcement
  requirePerUserCredentials Boolean @default(false)
  // Dutchie POS integration
  dutchieEnvironment                     String?  @default("none")
  encryptedDutchieLocationKey            String?
  encryptedDutchieIntegratorKey          String?
  encryptedDutchieSandboxLocationKey     String?
  encryptedDutchieSandboxIntegratorKey   String?
  dutchieFacilityTypes                   String[] @default(["retail"])  // "retail", "cultivation", "manufacturing"
  // Canix ERP integration
  canixEnvironment              String?  @default("none")  // "none" | "mock" | "sandbox" | "production"
  encryptedCanixApiKey          String?  // Encrypted production API key
  encryptedCanixSandboxApiKey   String?  // Encrypted sandbox API key
  canixFacilityId               String?  // Canix facility ID mapping
  licenseExpiryDate DateTime? @map("license_expiry_date")
  isActive         Boolean  @default(true)
  lastSyncAt       DateTime?
  lastSyncStatus   String?  // SUCCESS, FAILED, PARTIAL
  syncErrorMessage String?
  // Metadata
  timezone         String   @default("America/Los_Angeles")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations (organizationId is a logical cross-DB reference — no FK, see ADR-008)
  syncLogs             MetrcSyncLog[]
  businessRules        BusinessRule[]
  inventorySnapshots   InventorySnapshot[]
  complianceAlerts     ComplianceAlert[]
  actionLogs           ActionLog[]
  reportTemplates      ReportTemplate[]
  auditSnapshots       AuditSnapshot[]
  yieldRecords         YieldRecord[]
  tollingAgreements    TollingAgreement[]
  tollingBatches       TollingBatch[]
  reconciliationRecords ReconciliationRecord[]
  opexModels            OpExModel[]
  supplyCategories      SupplyCategory[]
  supplyItems           SupplyItem[]
  supplyTransactions    SupplyTransaction[]
  billsOfMaterial       BillOfMaterial[]
  autoDiscountConfig    AutoDiscountConfig?
  autoDiscountRuns      AutoDiscountRun[]
  dispositionPolicy     DispositionPolicy?
  dispositionRecords    DispositionRecord[]
  userCredentials       FacilityUserCredential[]
  facilityAccessGrants  FacilityAccess[]
  employees             Employee[]
  workLogs              WorkLog[]
  coaRecords            COARecord[]
  pipelineConfig        PipelineConfig?
  briefingSnapshots     BriefingSnapshot[]
  transferSnapshots     TransferSnapshot[]
  transferLineItems     TransferLineItem[]
  operatorBenchmarks    OperatorBenchmark[]
  retailSales           RetailSale[]
  retailSaleReceipts    RetailSaleReceipt[]
  packageSnapshots      PackageSnapshot[]
  plantSnapshots        PlantSnapshot[]
  plantBatchSnapshots   PlantBatchSnapshot[]
  harvestSnapshots      HarvestSnapshot[]
  labTestSnapshots      LabTestSnapshot[]
  syncWatermarks        SyncWatermark[]
  itemSnapshots         ItemSnapshot[]
  locationSnapshots     LocationSnapshot[]
  strainSnapshots       StrainSnapshot[]

  @@unique([organizationId, licenseNumber])
  @@index([organizationId, isActive])
  @@index([stateCode])
  @@map("metrc_facilities")
}

model MetrcSyncLog {
  id             String   @id @default(cuid())
  facilityId     String
  syncType       String   // FULL, INCREMENTAL, MANUAL
  status         String   // STARTED, SUCCESS, FAILED, PARTIAL
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  // Record counts
  plantsCount    Int?
  packagesCount  Int?
  transfersCount Int?
  salesCount     Int?
  // Error tracking
  errorMessage   String?
  errorDetails   Json?
  // Performance
  durationMs        Int?
  apiCallCount      Int?
  // Phase 1 additions
  entityType        String?  // 'packages' | 'plants' | 'harvests' | etc.
  rowsUpserted      Int?
  rowsStatusChanged Int?
  createdAt         DateTime @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, createdAt])
  @@index([status])
  @@map("metrc_sync_logs")
}

model BusinessRule {
  id           String   @id @default(cuid())
  facilityId   String
  name         String
  description  String?
  category     String   // aging, fifo, compliance, operations, inventory, discount
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  severity     String   @default("WARNING") // INFO, WARNING, CRITICAL
  stateCode    String?  @db.VarChar(2) // Optional: state-specific rule (e.g., "CO", "MA")
  // Rule definition as JSON DSL
  // { field: string, operator: string, value: any, itemCategory?: string }
  conditions   Json
  // Action to take when rule triggers
  actionType   String   @default("ALERT") // ALERT, NOTIFICATION, BLOCK, DISCOUNT_RECOMMEND, AUTO_DISCOUNT, PROMO_FLAG, CONSOLIDATE, SAMPLE_OUT
  actionParams Json?    // Discount action config: { discountRange, suggestedAction, ... }
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility         MetrcFacility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  complianceAlerts ComplianceAlert[]

  @@index([facilityId, category])
  @@index([facilityId, isActive, category, stateCode])
  @@map("business_rules")
}

model InventorySnapshot {
  id           String   @id @default(cuid())
  facilityId   String
  snapshotType String   // DAILY, MANUAL, PRE_AUDIT
  // Snapshot data stored as JSON for flexibility
  packagesData Json     // Array of package summaries
  plantsData   Json?    // Array of plant summaries
  // Aggregate stats
  totalPackages   Int
  totalQuantity   Float?
  totalCategories Int?
  // Aging distribution
  agingDistribution Json? // { "0-30": count, "31-60": count, "61-90": count, "90+": count }
  createdAt    DateTime @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, createdAt])
  @@index([facilityId, snapshotType])
  @@map("inventory_snapshots")
}

model ComplianceAlert {
  id           String   @id @default(cuid())
  facilityId   String
  category     String   // aging, fifo, weight, labeling, transfer, employee, reconciliation, discount
  severity     String   // INFO, WARNING, CRITICAL
  title        String
  description  String
  // References to Metrc entities
  packageLabel String?
  plantLabel   String?
  transferId   String?
  employeeId   String?
  // Alert lifecycle
  status       String   @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED, DISMISSED
  resolvedAt   DateTime?
  resolvedBy   String?
  resolutionNote String?
  // Rule that generated this alert
  ruleId       String?
  // Action type from the triggering rule (proper column for querying)
  actionType   String?  // ALERT, NOTIFICATION, BLOCK, DISCOUNT_RECOMMEND, AUTO_DISCOUNT, PROMO_FLAG, CONSOLIDATE, SAMPLE_OUT
  actionParams Json?    // Action-specific parameters
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  rule     BusinessRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  // Dedup constraint for createMany+skipDuplicates in rules-evaluation.ts.
  // packageLabel is always non-null for package-scoped rules (the only current source).
  // If non-package rules are added in future, use '' sentinel instead of null.
  @@unique([facilityId, ruleId, packageLabel, status])
  @@index([facilityId, status])
  @@index([facilityId, category])
  @@index([facilityId, severity])
  @@index([facilityId, createdAt])
  @@index([ruleId])
  @@index([facilityId, actionType])
  @@map("compliance_alerts")
}

model ActionLog {
  id           String   @id @default(cuid())
  facilityId   String
  userId       String
  actionType   String   // ADJUST, TRANSFER, DESTROY, CREATE_PACKAGE, FINISH, etc.
  // Preview -> Confirm -> Execute pipeline
  status       String   @default("PREVIEWING") // PREVIEWING, CONFIRMED, EXECUTING, COMPLETED, FAILED, ROLLED_BACK
  // Scope
  targetType   String   // PACKAGE, PLANT, TRANSFER, HARVEST
  targetIds    String[] // Metrc IDs affected
  targetCount  Int
  // State tracking
  previewData  Json?    // Computed diff shown to user
  beforeState  Json?    // State before execution
  afterState   Json?    // State after execution
  // Execution details
  executedAt   DateTime?
  errorMessage String?
  errorDetails Json?
  // Metrc API response
  metrcResponse Json?
  metadata     Json?
  // Origin — who initiated this action. NULL or 'USER' = direct human action;
  // 'COPILOT' = drafted by Copilot Run for human review-and-submit. When set,
  // `originatingRunId` references the Run that produced the draft.
  originatedBy String?  @map("originated_by") // 'USER' | 'COPILOT'
  originatingRunId String? @map("originating_run_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // FOR-1489: Restrict (not Cascade) — ActionLog is the cannabis compliance
  // audit trail. MA regs require 3-year retention; we don't want a stray
  // facility delete to silently wipe the trail. Facility removal must go
  // through soft-delete (isActive=false) or explicit ActionLog purge first.
  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId, createdAt])
  @@index([facilityId, status])
  @@index([userId])
  @@index([originatedBy, status])
  @@map("action_logs")
}

model ReportTemplate {
  id           String   @id @default(cuid())
  facilityId   String
  name         String
  description  String?
  // Report definition
  reportType   String   // INVENTORY, COMPLIANCE, OPERATIONS, ANALYTICS, CUSTOM
  columns      Json     // Array of column definitions
  filters      Json?    // Array of filter conditions
  groupBy      String[] // Column names to group by
  sortBy       Json?    // { column: string, direction: "asc" | "desc" }[]
  chartConfig  Json?    // Chart type and configuration
  // Template state
  isDefault    Boolean  @default(false)
  isShared     Boolean  @default(false)
  createdBy    String
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, reportType])
  @@index([createdBy])
  @@map("report_templates")
}

model AuditSnapshot {
  id           String   @id @default(cuid())
  facilityId   String
  auditType    String   // PRE_AUDIT, SELF_AUDIT, SCHEDULED
  // Scoring
  overallScore Float    // 0-100
  categoryScores Json   // { category: score }
  // Findings
  totalFindings  Int
  criticalCount  Int    @default(0)
  warningCount   Int    @default(0)
  infoCount      Int    @default(0)
  findings       Json   // Array of { category, severity, description, recommendation }
  // Snapshot reference
  inventorySnapshotId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, createdAt])
  @@map("audit_snapshots")
}

model YieldRecord {
  id           String   @id @default(cuid())
  facilityId   String
  // Tracking identifiers
  strainName   String
  batchId      String?
  harvestId    String?
  // Stage-by-stage yields
  stage        String   // VEGETATIVE, FLOWERING, HARVEST, DRYING, CURING, TRIM, EXTRACTION, PACKAGING
  inputWeight  Float
  outputWeight Float
  yieldPercent Float    // (output / input) * 100
  unitOfMeasure String  @default("grams")
  // Quality metrics
  potencyThc   Float?
  potencyCbd   Float?
  moistureContent Float?
  // Context
  notes        String?
  recordedBy   String?
  recordedAt   DateTime @default(now())
  metadata     Json?
  createdAt    DateTime @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, strainName])
  @@index([facilityId, stage])
  @@index([facilityId, createdAt])
  @@map("yield_records")
}

model TollingAgreement {
  id             String   @id @default(cuid())
  facilityId     String
  // Parties
  partnerName    String
  partnerLicense String?
  // Agreement details
  agreementType  String   // INBOUND (we process for them), OUTBOUND (they process for us)
  status         String   @default("ACTIVE") // DRAFT, ACTIVE, COMPLETED, CANCELLED
  startDate      DateTime
  endDate        DateTime?
  // Financial (legacy simple fields kept for backward compat)
  inputWeight    Float?
  outputWeight   Float?
  processingFee  Float?   // Per unit fee (simple mode)
  totalFees      Float?
  currency       String   @default("USD")
  // Advanced fee structure
  feeStructure   Json?    // Array<{ feeType, label, rate, basis, minFee?, maxFee?, notes? }>
  yieldGuarantee Float?   // Guaranteed minimum yield percentage
  qualityStandards Json?  // { thcMin, moistureMax, ... }
  // Package tracking
  inputPackageIds  String[]
  outputPackageIds String[]
  // Billing mode
  billingMode    String   @default("SEPARATE_INVOICE") // SEPARATE_INVOICE | BUILT_INTO_ECONOMICS
  // Terms
  terms          Json?    // { yieldGuarantee, qualityStandards, timeline }
  notes          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  batches  TollingBatch[]

  @@index([facilityId, status])
  @@index([facilityId, createdAt])
  @@map("tolling_agreements")
}

model TollingBatch {
  id             String   @id @default(cuid())
  facilityId     String
  agreementId    String
  status         String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, DISPUTED
  // Input tracking
  inputPackageIds  String[]
  inputWeight    Float?
  // Output tracking
  outputPackageIds String[]
  outputWeight   Float?
  // Fee calculation (computed on completion)
  calculatedFees Json?    // Array<{ feeType, label, amount, basis, rate }>
  totalFees      Float?
  // Yield tracking
  expectedYieldPct Float?
  actualYieldPct   Float?
  yieldVariance    Float?  // actual - expected
  // Waste
  wasteWeight    Float?
  wastePct       Float?
  // Lifecycle tracking
  lifecycleStage    String    @default("INTAKE") // INTAKE | PROCESSING | TESTING | FINISHED | SELLING | COMMENCED
  commencedAt       DateTime?
  lifecycleSnapshot Json?     // Cached BatchLifecycle snapshot
  // Metadata
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facility  MetrcFacility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  agreement TollingAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([facilityId, status])
  @@index([facilityId, lifecycleStage])
  @@index([agreementId])
  @@map("tolling_batches")
}

model ReconciliationRecord {
  id             String   @id @default(cuid())
  facilityId     String
  // Reconciliation scope
  reconciliationType String // INVENTORY, FINANCIAL, TRANSFER, FULL
  status         String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  // Sources
  sourceA        String   // e.g., "METRC"
  sourceB        String   // e.g., "POS_SYSTEM", "ERP", "CSV_IMPORT"
  // Results
  totalRecords   Int?
  matchedCount   Int?
  mismatchCount  Int?
  missingInA     Int?     // Records in B but not A
  missingInB     Int?     // Records in A but not B
  discrepancies  Json?    // Array of { field, valueA, valueB, packageLabel }
  // Resolution
  resolvedCount  Int?     @default(0)
  resolutionNotes String?
  completedAt    DateTime?
  completedBy    String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, reconciliationType])
  @@index([facilityId, status])
  @@index([facilityId, createdAt])
  @@map("reconciliation_records")
}

// ============================================================
// OPEX CALCULATOR ENGINE
// ============================================================

model OpExModel {
  id              String   @id @default(cuid())
  facilityId      String
  name            String   // "Base Case", "Expansion Plan"
  description     String?
  status          String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  version         Int      @default(1)
  isDefault       Boolean  @default(false)
  // Cached KPIs — denormalized for list views, recomputed on cell change
  annualRevenue   Float?
  annualCost      Float?
  costPerPound    Float?
  grossMargin     Float?
  grossProfit     Float?
  taxableProfit   Float?
  // Template KPI cell keys (populated on creation from template; empty = use defaults)
  kpiCells        String[]  @default([])
  // Import tracking
  sourceFile      String?  // original .xlsx filename
  importedAt      DateTime?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  facility  MetrcFacility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sections  OpExSection[]
  snapshots OpExSnapshot[]

  @@index([facilityId, status])
  @@index([facilityId, isDefault])
  @@index([createdBy])
  @@map("opex_models")
}

model OpExSection {
  id        String   @id @default(cuid())
  modelId   String
  name      String   // "Core Assumptions", "Cultivation", "Labor"
  slug      String   // URL-safe: "core", "labor", "cultivation"
  sortOrder Int
  icon      String?  // lucide icon name: "sprout", "users", "zap"
  parentId  String?  // self-ref for sub-sections
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  model      OpExModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  parent     OpExSection?  @relation("SectionHierarchy", fields: [parentId], references: [id])
  children   OpExSection[] @relation("SectionHierarchy")
  cellGroups OpExCellGroup[]

  @@unique([modelId, slug])
  @@index([modelId, sortOrder])
  @@map("opex_sections")
}

model OpExCellGroup {
  id        String   @id @default(cuid())
  sectionId String
  label     String   // "Yield Assumptions", "Lighting Costs"
  sortOrder Int
  createdAt DateTime @default(now())

  // Relations
  section OpExSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  cells   OpExCell[]

  @@index([sectionId, sortOrder])
  @@map("opex_cell_groups")
}

model OpExCell {
  id          String   @id @default(cuid())
  groupId     String
  modelId     String   // Denormalized for formula engine lookup
  key         String   // Unique within model: "core.yield_lbs", "labor.trim_hourly_rate"
  label       String   // Display: "Annual Yield (lbs)", "Trim Hourly Rate"
  cellType    String   // INPUT | COMPUTED | CONSTANT
  dataType    String   @default("number") // number | currency | percent | text
  // Value storage
  value       Float?   // Current numeric value (null for text cells)
  textValue   String?  // For text-type cells
  // Formula (for COMPUTED cells)
  formula     String?  // e.g., "core.yield_lbs * core.price_per_lb"
  dependsOn   String[] // Auto-generated from formula on write — never set manually
  // Display
  sortOrder   Int
  unit        String?  // "lbs", "$/hr", "kWh", "%"
  precision   Int      @default(2) // decimal places
  // Constraints
  minValue    Float?
  maxValue    Float?
  // Metadata
  tooltip     String?
  sourceSheet String?  // Import provenance only — not updated after import
  sourceCell  String?  // Original Excel cell ref, e.g., "B12"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  group     OpExCellGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([modelId, key])
  @@index([groupId, sortOrder])
  @@map("opex_cells")
}

model OpExSnapshot {
  id        String   @id @default(cuid())
  modelId   String
  name      String?  // "Pre-expansion baseline", "Q1 2026 actual"
  notes     String?
  // Full cell state at snapshot time
  cellData  Json     // Record<string, number | string | null> keyed by cell key
  // KPI values at snapshot time
  kpis      Json     // { annualRevenue, annualCost, costPerPound, grossMargin, grossProfit, taxableProfit }
  createdBy String
  createdAt DateTime @default(now())

  // Relations
  model OpExModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId, createdAt])
  @@index([createdBy])
  @@map("opex_snapshots")
}

// ============================================================
// BRIEFING SNAPSHOT HISTORY
// ============================================================

model BriefingSnapshot {
  id         String   @id @default(cuid())
  facilityId String
  metrics    Json     // { totalPackages, auditScore, fifoViolationCount, avgAgeDays, slowMovingCount, deadStockCount, onHoldCount, weeksOfSupply, insightCount }
  details    Json     // { fifoViolations: [{newerLabel, olderLabel, category, strain, daysDiff}], criticalAgingLabels: [...] }
  createdAt  DateTime @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, createdAt])
  @@map("briefing_snapshots")
}

// ============================================================
// NON-METRC INVENTORY (SUPPLY) SYSTEM
// ============================================================

model SupplyCategory {
  id        String   @id @default(cuid())
  facilityId String
  name      String   // "Packaging", "Labels", "Solvents"
  parentId  String?  // For hierarchy: Packaging > Bags > Mylar Bags
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility MetrcFacility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  parent   SupplyCategory? @relation("SupplyCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children SupplyCategory[] @relation("SupplyCategoryTree")
  items    SupplyItem[]

  @@unique([facilityId, name, parentId])
  @@index([facilityId])
  @@map("supply_categories")
}

model SupplyItem {
  id           String   @id @default(cuid())
  facilityId   String
  categoryId   String?
  name         String   // "1oz Mylar Bag - Black"
  sku          String?
  unit         String   @default("Each") // Each, Roll, Box, Gallon, etc.
  // Materialized aggregate — updated transactionally on every SupplyTransaction insert
  currentStock Float    @default(0)
  reorderPoint Float?   // Alert when stock drops below
  reorderQty   Float?   // Suggested reorder quantity
  unitCost     Float?   // Current unit cost
  vendor       String?  // Primary vendor name
  location     String?  // Storage location
  isActive     Boolean  @default(true)
  notes        String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facility     MetrcFacility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  category     SupplyCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions SupplyTransaction[]
  bomLines     BillOfMaterial[]

  @@unique([facilityId, sku])
  @@index([facilityId, categoryId])
  @@index([facilityId, isActive])
  @@map("supply_items")
}

model SupplyTransaction {
  id            String   @id @default(cuid())
  facilityId    String
  itemId        String
  type          String   // IN, OUT, ADJUST, BOM_DEDUCT
  quantity      Float    // Positive for IN, negative for OUT/ADJUST/BOM_DEDUCT
  referenceType String?  // "PURCHASE_ORDER", "PRODUCTION_RUN", "MANUAL", "METRC_PACKAGE"
  referenceId   String?  // PO number, Metrc package label, etc.
  notes         String?
  createdBy     String?  // userId
  createdAt     DateTime @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  item     SupplyItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([facilityId, itemId])
  @@index([facilityId, createdAt])
  @@index([itemId, type])
  @@map("supply_transactions")
}

model BillOfMaterial {
  id                     String   @id @default(cuid())
  facilityId             String
  metrcItemName          String   // Metrc item name (denormalized join key to external API)
  metrcItemCategory      String?  // "Flower", "Edible", etc.
  componentItemId        String?  // -> SupplyItem (nullable for Metrc-to-Metrc BOMs)
  componentMetrcItemName String?  // Metrc item name for Metrc-to-Metrc BOMs
  quantityPerUnit        Float    // How many of this component per unit of Metrc item
  unit                   String   @default("Each")
  notes                  String?
  isAutoInferred         Boolean  @default(false)
  inferenceConfidence    Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  facility      MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  componentItem SupplyItem?   @relation(fields: [componentItemId], references: [id], onDelete: Cascade)

  @@unique([facilityId, metrcItemName, componentItemId])
  @@index([facilityId, metrcItemName])
  @@map("bills_of_material")
}

// ============================================================
// AUTO-DISCOUNT ENGINE (FOR-961)
// ============================================================

model AutoDiscountConfig {
  id                   String   @id @default(cuid())
  facilityId           String   @unique
  isEnabled            Boolean  @default(false)
  // Guard rails
  maxDiscountPct       Float    @default(50)
  minPriceFloor        Float?   // Absolute minimum price (dollars)
  minScoreThreshold    Int      @default(30) // Only discount packages scoring >= this
  priorityFilter       String[] @default(["urgent", "high"]) // Which priority levels to auto-discount
  // Discount tiers: JSON array of { ageDays: number, discountPct: number }
  discountTiers        Json     @default("[{\"ageDays\":60,\"discountPct\":10},{\"ageDays\":90,\"discountPct\":20},{\"ageDays\":120,\"discountPct\":30}]")
  // Exclusions
  excludedProductIds   String[] @default([])
  excludedCategories   String[] @default([])
  // Per-category max discount overrides: { "Buds": 20, "Concentrate": 15 }
  categoryMaxDiscountPct Json?
  // Velocity integration
  useVelocityData      Boolean  @default(false)
  velocityLookbackDays Int      @default(30)
  // Approval mode
  requireApproval      Boolean  @default(true)
  // Run tracking
  lastRunAt            DateTime?
  lastRunStatus        String?  // COMPLETED, FAILED, SKIPPED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  runs     AutoDiscountRun[]

  @@map("auto_discount_configs")
}

model AutoDiscountRun {
  id                    String   @id @default(cuid())
  facilityId            String
  configId              String
  trigger               String   // "cron" | "manual"
  status                String   @default("PENDING") // PENDING, PREVIEWING, APPROVED, EXECUTING, COMPLETED, FAILED, SKIPPED
  // Counts
  recommendationCount   Int      @default(0)
  overrideCount         Int      @default(0)
  succeededCount        Int      @default(0)
  failedCount           Int      @default(0)
  // Financials
  estimatedRevenueImpact Float?
  // Plan data: JSON array of { packageLabel, productId, productName, oldPrice, newPrice, discountPct, score, ageDays, category }
  planData              Json?
  resultData            Json?    // Execution results (succeeded/failed product IDs)
  // Audit
  actionLogId           String?
  errorMessage          String?
  // Timestamps
  startedAt             DateTime @default(now())
  completedAt           DateTime?
  createdAt             DateTime @default(now())

  facility MetrcFacility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  config   AutoDiscountConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([facilityId, createdAt])
  @@index([facilityId, status])
  @@index([configId])
  @@map("auto_discount_runs")
}

// ============================================================
