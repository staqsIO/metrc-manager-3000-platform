  // Link to Metrc package
  packageLabel String?
  packageId    Int?     // Metrc package ID
  // PDF storage
  fileName     String
  fileSize     Int      // bytes
  // Parsed data (JSON for flexibility)
  terpenes     Json?    // TerpeneResult[]
