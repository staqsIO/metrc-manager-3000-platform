  isEnabled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  statuses PipelineStatus[]
  facility MetrcFacility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("pipeline_configs")
}

model PipelineStatus {
  id            String   @id @default(cuid())
  configId      String
  /// System phase this status belongs to (harvested, post_harvest, testing, processed, retail_ready, in_transit, sold)
  phase         String
  /// User-defined display name (e.g., "Extraction", "Curing Room 1")
  name          String
  /// Sort order within the phase (for display)
  sortOrder     Int      @default(0)
  /// Hex color for UI (optional, inherits phase color if null)
  color         String?
  /// Metrc location names assigned to this status (JSON array of strings)
  locationNames Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

