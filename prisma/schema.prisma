  name               String
  locationTypeId     Int?
  locationTypeName   String?
  isActive           Boolean   @default(true)
  rawPayload         Json?
  lastSyncedAt       DateTime  @default(now())
  capturedAt         DateTime  @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

