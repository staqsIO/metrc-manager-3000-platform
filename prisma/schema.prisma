// ============================================================
// TRANSFER SNAPSHOT HISTORY
// ============================================================

model TransferSnapshot {
  id                  String   @id @default(cuid())
  facilityId          String
  metrcTransferId     Int      // Metrc's transfer ID — natural key for upsert
  direction           String   // 'incoming' | 'outgoing' | 'rejected'
  manifestNumber      String
  shipperFacilityLicenseNumber  String
  shipperFacilityName           String
  receiverFacilityLicenseNumber String?
  receiverFacilityName          String?
  transporterFacilityLicenseNumber String?
  transporterFacilityName          String?
  deliveryCount       Int
  receivedDeliveryCount Int
  packageCount        Int
  receivedPackageCount Int
  containsDonation    Boolean  @default(false)
  containsTradeSample Boolean  @default(false)
  containsTestingSample Boolean @default(false)
  estimatedDepartureDateTime String
  estimatedArrivalDateTime   String
  receivedDateTime    String?
  createdDateTime     String
  lastModified        String
  lastSeenAt          DateTime @default(now()) // When we last saw this transfer in the API
  firstSeenAt         DateTime @default(now()) // When we first captured this transfer
  isActive            Boolean  @default(true)  // false = no longer in Metrc API (completed/accepted)
  // Phase 3 additions — typed columns promoted from rawPayload / sync metadata
  metrcLastModified   DateTime?
  rawPayload          Json?
  lastSyncedAt        DateTime @default(now())

  facility       MetrcFacility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  deliveries     TransferDeliveryRecord[]

  @@unique([facilityId, metrcTransferId, direction])
  @@index([facilityId, direction, isActive])
  @@index([facilityId, manifestNumber])
  @@index([facilityId, metrcLastModified])
  @@map("transfer_snapshots")
}

/// Transfer delivery drill-down record (Phase 3).
/// One TransferSnapshot has many deliveries. Each delivery has many packages.
/// Only re-walked from Metrc when the parent transfer's LastModified changes.
/// Frozen (never re-walked) once `isCompleted = true` (receivedDateTime set).
model TransferDeliveryRecord {
  id                        String    @id @default(cuid())
  transferSnapshotId        String
  metrcDeliveryId           Int
  recipientFacilityLicenseNumber String
  recipientFacilityName     String
  shipmentTypeName          String?
  shipmentTransactionType   String?
  estimatedDepartureDateTime String?
  estimatedArrivalDateTime  String?
  actualDepartureDateTime   String?
  actualArrivalDateTime     String?
  receivedDateTime          String?
  receivedByName            String?
  grossWeight               Decimal? @db.Decimal(12, 4)
  grossUnitOfWeightName     String?
  plannedRoute              String?
  totalPackages             Int       @default(0)
  totalPrice                Decimal?  @db.Decimal(14, 2)
  isCompleted               Boolean   @default(false) // true when receivedDateTime set — frozen
  rawPayload                Json?
  lastSyncedAt              DateTime  @default(now())
  capturedAt                DateTime  @default(now())

  transfer TransferSnapshot           @relation(fields: [transferSnapshotId], references: [id], onDelete: Cascade)
  packages TransferPackageRecord[]

  @@unique([transferSnapshotId, metrcDeliveryId])
  @@index([transferSnapshotId, isCompleted])
  @@map("transfer_delivery_records")
}

/// Transfer package drill-down record (Phase 3).
/// One TransferDeliveryRecord has many packages.
/// Immutable after the parent delivery is `isCompleted`.
model TransferPackageRecord {
  id                    String   @id @default(cuid())
  deliveryRecordId      String
  metrcPackageId        Int
  packageLabel          String
  packageType           String?
  itemName              String
  itemStrainName        String?
  itemCategory          String?
  quantity              Decimal  @db.Decimal(14, 4)
  unitOfMeasureName     String?
  grossWeight           Decimal? @db.Decimal(12, 4)
  grossUnitOfWeightName String?
  wholesalePrice        Decimal? @db.Decimal(14, 2)
  shipmentPackageState  String?
  labTestingState       String?
  remediationDate       String?
  rawPayload            Json?
  lastSyncedAt          DateTime @default(now())
  capturedAt            DateTime @default(now())

  delivery TransferDeliveryRecord @relation(fields: [deliveryRecordId], references: [id], onDelete: Cascade)

  @@unique([deliveryRecordId, metrcPackageId])
  @@index([deliveryRecordId, packageLabel])
  @@index([packageLabel])
  @@map("transfer_package_records")
}

/// Catalog: Item master list snapshot (Phase 3).
/// Populated by catalog-sync.ts, daily cadence.
model ItemSnapshot {
  id                       String    @id @default(cuid())
  facilityId               String
  metrcItemId              Int
  name                     String
  productCategoryName      String?
  productCategoryType      String?
  quantityType             String?
  defaultLabTestingState   String?
  unitOfMeasureName        String?
  strainName               String?
  isActive                 Boolean   @default(true)
  rawPayload               Json?
  lastSyncedAt             DateTime  @default(now())
  capturedAt               DateTime  @default(now())

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, metrcItemId])
  @@index([facilityId, isActive])
  @@index([facilityId, productCategoryName])
  @@map("item_snapshots")
}

/// Catalog: Location master list snapshot (Phase 3).
/// Populated by catalog-sync.ts, daily cadence.
model LocationSnapshot {
