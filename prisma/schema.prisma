model DispositionPolicy {
  id              String   @id @default(cuid())
  facilityId      String   @unique
  isEnabled       Boolean  @default(true)
  // Per-category monthly limits: { "sample": { units: 100, value: 5000 }, "vendor_day": ... }
  categoryLimits  Json     @default("{}")
  // Global settings
  allowBudgetOverride Boolean @default(false) // Allow dispositions that exceed budget limits
  requireNote     Boolean  @default(true)  // Require a note on every disposition
  alertThreshold  Float    @default(0.85)  // Alert when budget hits this fraction (85%)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility MetrcFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("disposition_policies")
}

model DispositionRecord {
  id              String   @id @default(cuid())
  facilityId      String
  packageLabel    String
  category        String   // sample, vendor_day, promo, damage, waste
  quantity        Float
  unitOfMeasure   String
  estimatedValue  Float    @default(0)
